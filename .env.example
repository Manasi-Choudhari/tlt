# Copy to .env.local (local) or add in your hosting dashboard (Vercel → Settings → Environment Variables).
# Every variable is optional — the site works without any of them.

# Public URL used for SEO metadata, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://tltcommunity.in

# --- Travel assistant (chatbot) ---
# Without a key, the built-in rule-based assistant answers from the trip data.
# With a key, replies come from any OpenAI-compatible API, restricted to travel topics.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Form submissions (contact, enquiry, feedback, newsletter) ---
# Without these, submissions are only written to the server log.
# Option A: POST every submission as JSON to a webhook (Zapier, Make, n8n, Google Apps Script, Slack…).
LEADS_WEBHOOK_URL=
# Option B: email every submission via Resend (https://resend.com).
RESEND_API_KEY=
LEADS_TO_EMAIL=hello@tltcommunity.in
LEADS_FROM_EMAIL=TLT Website <website@tltcommunity.in>
